# انسخ هذا الملف إلى .env في بيئة التشغيل. لا تضع أسرارًا في المستودع.
PORT=3000
NODE_ENV=production
TZ=Africa/Cairo
# مسار قاعدة البيانات (SQLite حاليًا؛ PostgreSQL في المرحلة التالية)
DB_PATH=/var/lib/acc/app.db
# مجلد المرفقات (يُستبدل بـObject Storage لاحقًا)
FILES_DIR=/var/lib/acc/files
# 1 فقط في بيئة العرض: يُظهر الحسابات التجريبية ورمز إعادة التعيين
DEMO_MODE=0
# 1 خلف HTTPS: يفعّل Secure cookie وHSTS
HTTPS=1
SESSION_HOURS=8
LOG_LEVEL=info
# 0 لمنع إنشاء بيانات Demo تلقائيًا عند قاعدة فارغة
AUTO_SEED=0
