<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acc_meeting_list" model="ir.ui.view">
        <field name="name">acc.meeting.list</field>
        <field name="model">acc.meeting</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="reference"/>
                <field name="name"/>
                <field name="meeting_type_id"/>
                <field name="date_start"/>
                <field name="organizer_id" widget="many2one_avatar_user"/>
                <field name="task_count" string="Action Items"/>
                <field name="completion_rate" widget="progressbar" string="Completion"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'scheduled'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_acc_meeting_form" model="ir.ui.view">
        <field name="name">acc.meeting.form</field>
        <field name="model">acc.meeting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm &amp; Send Invitations" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_load_items" string="Load Pending Items" type="object"
                            invisible="state not in ('draft', 'scheduled')"
                            help="Loads the previous action items to review and the items escalated to this meeting level."/>
                    <button name="action_start" string="Start Meeting" type="object"
                            class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_done" string="Close Meeting" type="object"
                            class="btn-primary" invisible="state not in ('scheduled', 'in_progress')"
                            confirm="Close the meeting? Review results will be applied to the previous action items."/>
                    <button name="action_schedule_next" string="Schedule Next Meeting" type="object"
                            class="btn-primary" invisible="state != 'done' or next_meeting_id"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"
                            confirm="Cancel this meeting? The calendar invitation will be withdrawn."/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state not in ('cancelled', 'scheduled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button"
                                icon="fa-tasks" invisible="task_count == 0">
                            <field name="task_count" widget="statinfo" string="Action Items"/>
                        </button>
                        <button name="action_view_previous" type="object" class="oe_stat_button"
                                icon="fa-backward" invisible="not previous_meeting_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Previous Meeting</span>
                            </div>
                        </button>
                        <button name="action_view_next" type="object" class="oe_stat_button"
                                icon="fa-forward" invisible="not next_meeting_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Next Meeting</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <field name="reference" class="text-muted"/>
                        <h1>
                            <field name="name" placeholder="Meeting subject"
                                   readonly="state in ('done', 'cancelled')"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Schedule">
                            <field name="meeting_type_id" options="{'no_create': True}"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="date_start" readonly="state in ('done', 'cancelled')"/>
                            <field name="duration" widget="float_time"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="date_stop"/>
                            <field name="location" readonly="state in ('done', 'cancelled')"/>
                            <field name="online_link" widget="url"
                                   readonly="state in ('done', 'cancelled')"/>
                        </group>
                        <group string="Roles">
                            <field name="organizer_id" widget="many2one_avatar_user"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="chairperson_id" widget="many2one_avatar_user"/>
                            <field name="secretary_id" widget="many2one_avatar_user"/>
                            <field name="previous_meeting_id" readonly="state != 'draft'"/>
                            <field name="next_meeting_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenda" name="agenda">
                            <field name="objective" placeholder="Objective of the meeting..."
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="agenda_line_ids"
                                   readonly="state in ('done', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="presenter_id" widget="many2one_avatar_user"/>
                                    <field name="duration_minutes" sum="Total"/>
                                    <field name="source" widget="badge"
                                           decoration-warning="source == 'escalated'" readonly="1"/>
                                    <field name="task_id" readonly="1" optional="show"/>
                                    <field name="description" optional="hide"/>
                                    <field name="discussed"/>
                                    <field name="outcome" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="agenda_duration"/>
                            </group>
                        </page>
                        <page string="Attendees" name="attendees">
                            <field name="attendee_ids" readonly="state in ('done', 'cancelled')">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="email" optional="show"/>
                                    <field name="attendance"/>
                                </list>
                            </field>
                        </page>
                        <page string="Previous Actions Review" name="followup">
                            <group>
                                <group>
                                    <field name="followup_count" string="Items to review"/>
                                    <field name="followup_completed_count" string="Completed"/>
                                    <field name="followup_deviation_count" string="Deviations"/>
                                </group>
                            </group>
                            <field name="followup_ids" readonly="state in ('done', 'cancelled')">
                                <list editable="bottom" create="0"
                                      decoration-success="review_state == 'completed'"
                                      decoration-danger="review_state in ('delayed', 'cancelled')">
                                    <field name="task_id" readonly="1"/>
                                    <field name="origin_meeting_id" readonly="1" optional="hide"/>
                                    <field name="assignee_id" widget="many2one_avatar_user" readonly="1"/>
                                    <field name="date_deadline" readonly="1"/>
                                    <field name="task_state" widget="badge" readonly="1"/>
                                    <field name="review_state"/>
                                    <field name="deviation_reason_id" options="{'no_create': True}"
                                           required="review_state in ('delayed', 'cancelled')"
                                           readonly="review_state not in ('delayed', 'cancelled')"/>
                                    <field name="new_due_date"
                                           required="review_state == 'delayed'"
                                           readonly="review_state != 'delayed'"/>
                                    <field name="deviation_notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Minutes" name="minutes">
                            <field name="minutes" placeholder="Discussion summary and key points..."
                                   readonly="state in ('done', 'cancelled')"/>
                        </page>
                        <page string="Action Items" name="tasks">
                            <field name="task_ids" readonly="state in ('draft', 'cancelled')">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="task_type"/>
                                    <field name="assignee_id" widget="many2one_avatar_user"/>
                                    <field name="date_deadline"/>
                                    <field name="priority"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_acc_meeting_calendar" model="ir.ui.view">
        <field name="name">acc.meeting.calendar</field>
        <field name="model">acc.meeting</field>
        <field name="arch" type="xml">
            <calendar string="Meetings" date_start="date_start" date_stop="date_stop"
                      color="meeting_type_id" mode="month">
                <field name="name"/>
                <field name="meeting_type_id"/>
                <field name="location"/>
            </calendar>
        </field>
    </record>

    <record id="view_acc_meeting_search" model="ir.ui.view">
        <field name="name">acc.meeting.search</field>
        <field name="model">acc.meeting</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Meeting" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="meeting_type_id"/>
                <field name="organizer_id"/>
                <field name="attendee_ids" string="Attendee"/>
                <filter name="my_meetings" string="My Meetings"
                        domain="[('allowed_user_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="date_start" string="Date" date="date_start"/>
                <group>
                    <filter name="group_type" string="Meeting Type" context="{'group_by': 'meeting_type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_organizer" string="Organizer" context="{'group_by': 'organizer_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_acc_meeting" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">acc.meeting</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_acc_meeting_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first meeting</p>
            <p>Prepare the agenda, invite the attendees, record the minutes and assign the action items.
               The next meeting will automatically list the previous action items for review.</p>
        </field>
    </record>
</odoo>
