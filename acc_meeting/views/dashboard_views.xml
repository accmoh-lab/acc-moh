<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard entries: pre-configured analysis screens (pivot / graph / list). -->

    <record id="action_acc_dashboard_department" model="ir.actions.act_window">
        <field name="name">Performance by Department</field>
        <field name="res_model">acc.meeting.task</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_acc_meeting_task_search"/>
        <field name="context">{
            'pivot_row_groupby': ['department_id'],
            'pivot_column_groupby': ['state'],
            'graph_groupbys': ['department_id', 'state'],
        }</field>
    </record>

    <record id="action_acc_dashboard_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Items</field>
        <field name="res_model">acc.meeting.task</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="view_acc_meeting_task_search"/>
        <field name="context">{
            'search_default_overdue': 1,
            'pivot_row_groupby': ['assignee_id'],
            'graph_groupbys': ['assignee_id'],
        }</field>
    </record>

    <record id="action_acc_dashboard_escalated" model="ir.actions.act_window">
        <field name="name">Escalated Items (Board &amp; Senior Management)</field>
        <field name="res_model">acc.meeting.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_acc_meeting_task_search"/>
        <field name="domain">[('state', '=', 'escalated')]</field>
    </record>

    <record id="action_acc_dashboard_meeting_type" model="ir.actions.act_window">
        <field name="name">Completion by Meeting Type</field>
        <field name="res_model">acc.meeting.task</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_acc_meeting_task_search"/>
        <field name="context">{
            'pivot_row_groupby': ['meeting_type_id'],
            'pivot_column_groupby': ['state'],
            'graph_groupbys': ['meeting_type_id', 'state'],
        }</field>
    </record>
</odoo>
