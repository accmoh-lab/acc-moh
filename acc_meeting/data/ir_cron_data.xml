<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_overdue_reminders" model="ir.cron">
        <field name="name">Meetings: remind overdue action items</field>
        <field name="model_id" ref="model_acc_meeting_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_overdue_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_release_preparations" model="ir.cron">
        <field name="name">Meetings: release preparation reports to attendees</field>
        <field name="model_id" ref="model_acc_meeting_preparation"/>
        <field name="state">code</field>
        <field name="code">model._cron_release_preparations()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Hours before the meeting at which the preparation report becomes visible to attendees -->
    <record id="config_prep_release_hours" model="ir.config_parameter">
        <field name="key">acc_meeting.prep_release_hours</field>
        <field name="value">48</field>
    </record>
</odoo>
